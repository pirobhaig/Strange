# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Optional Third-Party Integrations (Configure in Settings > Secrets; never expose to frontend)
WHOP_API_KEY=""
WHOP_COMPANY_ID=""

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# Optional Custom Local Data Directory (defaults to ./data)
STRANGE_DATA_DIR=""
